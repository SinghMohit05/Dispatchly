# ═══════════════════════════════════════════════════════════
# Dispatchly — Environment Variables
# Copy to .env and fill in real values before running.
# Every value here is loaded and validated at startup via Zod.
# ═══════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (Postgres) ──────────────────────────────────
DATABASE_URL=postgresql://dispatchly:dispatchly@localhost:5432/dispatchly

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── BullMQ / Worker ──────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_DELAY_MS=500

# ── Rate Limits ───────────────────────────────────────────
MAX_EMAILS_PER_HOUR=500
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ── SMTP (Ethereal — get credentials at https://ethereal.email) ──
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Resend (https://resend.com — modern email API) ──
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Session ───────────────────────────────────────────────
SESSION_SECRET=change-me-in-production

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
